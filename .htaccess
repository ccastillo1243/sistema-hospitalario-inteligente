# El document root debe apuntar a /public. Este archivo es una defensa
# adicional por si el servidor se configura apuntando a la raíz del proyecto:
# bloquea el acceso directo al código fuente, la base de datos y las dependencias.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
