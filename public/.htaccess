# Anula el "Require all denied" del .htaccess de la raíz del proyecto,
# necesario cuando se accede vía htdocs/proyecto/public/ sin Virtual Host.
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

RewriteEngine On

# Servir archivos y directorios existentes directamente (assets, login.php, app.php, index.php)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Cualquier otra ruta (endpoints de la API) va al router
RewriteRule ^ index.php [L]
